{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "outDir": "./dist",
    "rootDir": "./webapp",
    "types": ["@sapui5/types"],
    "paths": {
      "ordersv4freestyle/*": ["./webapp/*"]
    }
  },
  "include": ["./webapp/**/*"],
  "exclude": ["./webapp/test/**/*"]
}
