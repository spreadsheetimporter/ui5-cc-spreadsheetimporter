# Copy this file to .env (gitignored) and fill in your values. NEVER commit .env.
#
# Backend host the dev proxy forwards every /sap/** request to:
BACKEND_URL=http://your-s4-host:50000
#
# Backend credentials — read automatically by fiori-tools-proxy (no manual export needed):
FIORI_TOOLS_USER=YOUR_USER
FIORI_TOOLS_PASSWORD=your-password
